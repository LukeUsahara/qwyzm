{
  "name": "qwyzm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @qwyzm/web --filter @qwyzm/api --filter @qwyzm/signaling dev",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test",
    "build": "pnpm -r --if-present build",
    "db:migrate": "pnpm --filter @qwyzm/db migrate",
    "db:seed": "pnpm --filter @qwyzm/db seed && pnpm --filter @qwyzm/api seed-admin"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
